[TEMPLATE]
# Copy to .env (mode 0600). Never commit the real file.

# Companies House Advanced Search — free self-service key
COMPANIES_HOUSE_API_KEY=

# AI provider for the extraction step only. Leave blank to run heuristic-only.
# LLM_PROVIDER is `anthropic` (default) or `openai` — any OpenAI-format
# chat-completions gateway (e.g. a proxy whose only key is OpenAI-shaped).
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_BASE_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=

# Google Sheets
GOOGLE_SA_JSON=/opt/founder-radar/secrets/google-sa.json
SHEET_ID=<your-sheet-id>

# Paths
RADAR_DB=/opt/founder-radar/data/radar.db

# Crawler identity — the URL must resolve to the published privacy notice
RADAR_USER_AGENT=founder-radar/2.0 (+https://example.com/privacy-notice; contact@example.com)

# Review surface (deploy/Caddyfile + founder-radar-web.service).
# Leave blank and the surface stays on 127.0.0.1 — reachable from the box only,
# which is the safe default rather than a broken one.
#
# RADAR_WEB_PASS_HASH is a bcrypt hash, not the password. Generate it on the
# server and never write the plaintext down:
#     caddy hash-password --plaintext 'choose-a-password'
RADAR_WEB_DOMAIN=
RADAR_WEB_USER=scout
RADAR_WEB_PASS_HASH=
